{
  "manifest_version": 3,
  "name": "Better Conversions",
  "version": "1.0.0",
  "description": "Converts conventional units of measurement into better ones.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}